#
# ~/.bash_login
#

export TEST_DIR=/tmp/test_${USER}
if [ ! -e ${TEST_DIR} ]
then
	mkdir ${TEST_DIR}
	chmod 0700 ${TEST_DIR}
	cp -r ~/.dotfiles/test/* ${TEST_DIR}
	cp -r ~/.dotfiles/test/.* ${TEST_DIR}
fi

export SCRATCHPAD="/tmp/scratchpad_${USER}"
if [ ! -e ${SCRATCHPAD} ]
then
	cp ~/personal/scratchpad_template ${SCRATCHPAD}
	chmod 0600 ${SCRATCHPAD}
fi
